# Salin file ini menjadi .env.local (lokal) dan masukkan variabel yang sama ke Vercel -> Project Settings -> Environment Variables
# Lokasi kunci di Dashboard Supabase: Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Kunci khusus server-side (KHUSUS server, JANGAN pernah diberi awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_atau_service_role_key_anda

# Opsional (disarankan di produksi Vercel): string acak panjang untuk menandatangani cookie sesi PIN kasir
KASIR_SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
